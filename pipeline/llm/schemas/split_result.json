{
  "name": "SplitResult",
  "strict": true,
  "schema": {
    "type": "object",
    "properties": {
      "questions": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "question_number": {
              "type": [
                "string",
                "null"
              ]
            },
            "content": {
              "type": "string",
              "minLength": 1
            },
            "page": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "is_noise": {
              "type": "boolean"
            },
            "noise_reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "content",
            "is_noise"
          ]
        }
      }
    },
    "required": [
      "questions"
    ]
  }
}